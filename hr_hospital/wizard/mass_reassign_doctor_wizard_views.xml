<odoo>
    <record id="mass_reassign_doctor_wizard_view_form" model="ir.ui.view">
        <field name="name">mass.reassign.doctor.wizard.form</field>
        <field name="model">mass.reassign.doctor.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="new_doctor_id"/>
                    <field name="change_date"/>
                </group>
                <footer>
                    <button name="action_reassign" type="object" string="Assign Doctor" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="mass_reassign_doctor_wizard_action" model="ir.actions.act_window">
        <field name="name">Reassign Personal Doctor</field>
        <field name="res_model">mass.reassign.doctor.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mass_reassign_doctor_wizard_view_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_patient"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
