<odoo>
    <record id="hospital_doctor_history_view_list" model="ir.ui.view">
        <field name="name">hospital.doctor.history.list</field>
        <field name="model">hospital.doctor.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name" string="Assignment History"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="assignment_date"/>
                <field name="change_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="hospital_doctor_history_view_form" model="ir.ui.view">
        <field name="name">hospital.doctor.history.form</field>
        <field name="model">hospital.doctor.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="patient_id"/>
                        <field name="doctor_id"/>
                        <field name="assignment_date"/>
                        <field name="change_date"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hospital_doctor_history_view_search" model="ir.ui.view">
        <field name="name">hospital.doctor.history.search</field>
        <field name="model">hospital.doctor.history</field>
        <field name="arch" type="xml"><search>
            <field name="patient_id"/><field name="doctor_id"/>
            <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
        </search></field>
    </record>
    <record id="hospital_doctor_history_action" model="ir.actions.act_window">
        <field name="name">Personal Doctor History</field>
        <field name="res_model">hospital.doctor.history</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
