<odoo>
    <record id="hr_hospital_patient_visit_view_list" model="ir.ui.view">
        <field name="name">hr.hospital.patient.visit.view.list</field>
        <field name="model">hr.hospital.patient.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="visit_datetime"/>
                <field name="actual_visit_datetime" optional="hide"/>
                <field name="disease_id" optional="hide"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_patient_visit_view_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.visit.view.form</field>
        <field name="model">hr.hospital.patient.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="planned,done,cancelled" options="{'clickable': True}" readonly="state == 'done'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_same_disease_visits" type="object" class="oe_stat_button" icon="fa-stethoscope" invisible="not disease_id">
                            <field name="same_disease_visit_count" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="patient_id"/>
                            <field name="doctor_id" readonly="state == 'done'"/>
                            <field name="disease_id"/>
                        </group>
                        <group>
                            <field name="visit_datetime" readonly="state == 'done'"/>
                            <field name="actual_visit_datetime" readonly="state == 'done'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clinical Summary">
                            <field name="summary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hospital_visit_view_search" model="ir.ui.view">
        <field name="name">hospital.visit.search</field>
        <field name="model">hr.hospital.patient.visit</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/><field name="doctor_id"/>
                <field name="disease_id" operator="child_of"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="current_year" string="Current Year" date="visit_datetime" default_period="year"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_disease" string="Disease" context="{'group_by': 'disease_id'}"/>
                    <filter name="group_doctor" string="Doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'visit_datetime:month'}"/>
                </group>
                <searchpanel>
                    <field name="doctor_id" string="Doctor" enable_counters="1"/>
                    <field name="disease_id" string="Disease" hierarchize="1" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="hospital_visit_view_calendar" model="ir.ui.view">
        <field name="name">hospital.visit.calendar</field>
        <field name="model">hr.hospital.patient.visit</field>
        <field name="arch" type="xml">
            <calendar date_start="visit_datetime" color="doctor_id" mode="month" quick_create="0" event_open_popup="1">
                <field name="patient_id"/><field name="doctor_id" filters="1"/>
                <field name="disease_id"/><field name="state"/>
            </calendar>
        </field>
    </record>
    <record id="hospital_visit_view_pivot" model="ir.ui.view">
        <field name="name">hospital.visit.pivot</field>
        <field name="model">hr.hospital.patient.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visits by Doctor and Status" display_quantity="1">
                <field name="doctor_id" type="row"/>
                <field name="visit_datetime" type="row" interval="month"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="hospital_visit_view_graph" model="ir.ui.view">
        <field name="name">hospital.visit.graph</field>
        <field name="model">hr.hospital.patient.visit</field>
        <field name="arch" type="xml">
            <graph string="Visits by Month and Disease" type="bar" stacked="1">
                <field name="visit_datetime" interval="month"/>
                <field name="disease_id"/>
            </graph>
        </field>
    </record>
    <record id="hospital_visit_analysis_action" model="ir.actions.act_window">
        <field name="name">Visit Analysis for the Current Year</field>
        <field name="res_model">hr.hospital.patient.visit</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="context">{'search_default_current_year': 1}</field>
    </record>
    <record id="hr_hospital_patient_visit_action" model="ir.actions.act_window">
        <field name="name">Patient Visits</field>
        <field name="res_model">hr.hospital.patient.visit</field>
        <field name="view_mode">list,form,calendar,pivot,graph</field>
    </record>
</odoo>
