<odoo>
    <record id="hr_hospital_disease_view_list" model="ir.ui.view">
        <field name="name">hr.hospital.disease.view.list</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name" string="Disease"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_disease_view_form" model="ir.ui.view">
        <field name="name">hr.hospital.disease.view.form</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                    </group>
                    <group string="Child Diseases">
                        <field name="child_ids" readonly="1" nolabel="1">
                            <list>
                                <field name="display_name" string="Disease"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hospital_disease_view_search" model="ir.ui.view">
        <field name="name">hospital.disease.search</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <searchpanel><field name="parent_id" hierarchize="1" expand="1"/></searchpanel>
            </search>
        </field>
    </record>
    <record id="hr_hospital_disease_action" model="ir.actions.act_window">
        <field name="name">Diseases</field>
        <field name="res_model">hr.hospital.disease</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
