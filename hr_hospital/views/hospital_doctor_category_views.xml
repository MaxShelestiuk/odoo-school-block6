<odoo>
    <record id="hospital_doctor_category_view_list" model="ir.ui.view">
        <field name="name">hospital.doctor.category.list</field>
        <field name="model">hospital.doctor.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="hospital_doctor_category_view_form" model="ir.ui.view">
        <field name="name">hospital.doctor.category.form</field>
        <field name="model">hospital.doctor.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>

                    <group string="Doctors with This Qualification">
                        <field name="doctor_ids" readonly="1">
                            <list>
                                <field name="name"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hospital_doctor_category_action" model="ir.actions.act_window">
        <field name="name">Doctor Qualifications</field>
        <field name="res_model">hospital.doctor.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
