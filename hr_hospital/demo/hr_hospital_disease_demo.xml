<odoo noupdate="1">
    <record id="disease_demo_infectious" model="hr.hospital.disease">
        <field name="name">Infectious Diseases</field>
    </record>

    <record id="disease_demo_viral" model="hr.hospital.disease">
        <field name="name">Viral Diseases</field>
        <field name="parent_id" ref="disease_demo_infectious"/>
    </record>

    <record id="disease_demo_flu" model="hr.hospital.disease">
        <field name="name">Influenza</field>
        <field name="parent_id" ref="disease_demo_viral"/>
    </record>

    <record id="disease_demo_bacterial" model="hr.hospital.disease">
        <field name="name">Bacterial Diseases</field>
        <field name="parent_id" ref="disease_demo_infectious"/>
    </record>

    <record id="disease_demo_scarlet_fever" model="hr.hospital.disease">
        <field name="name">Scarlet Fever</field>
        <field name="parent_id" ref="disease_demo_bacterial"/>
    </record>
</odoo>
