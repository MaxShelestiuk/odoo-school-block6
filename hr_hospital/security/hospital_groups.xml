<odoo>
<record id="module_category_hospital" model="ir.module.category"><field name="name">Hospital</field></record>
<record id="privilege_hospital" model="res.groups.privilege"><field name="name">Hospital</field><field name="category_id" ref="module_category_hospital"/></record>
<record id="group_hospital_patient" model="res.groups"><field name="name">Patient</field><field name="privilege_id" ref="privilege_hospital"/><field name="sequence">1</field><field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/></record>
<record id="group_hospital_intern" model="res.groups"><field name="name">Intern</field><field name="privilege_id" ref="privilege_hospital"/><field name="sequence">2</field><field name="implied_ids" eval="[Command.link(ref('group_hospital_patient'))]"/></record>
<record id="group_hospital_doctor" model="res.groups"><field name="name">Doctor</field><field name="privilege_id" ref="privilege_hospital"/><field name="sequence">3</field><field name="implied_ids" eval="[Command.link(ref('group_hospital_intern'))]"/></record>
<record id="group_hospital_manager" model="res.groups"><field name="name">Manager</field><field name="privilege_id" ref="privilege_hospital"/><field name="sequence">4</field><field name="implied_ids" eval="[Command.link(ref('group_hospital_doctor'))]"/></record>
<record id="group_hospital_admin" model="res.groups"><field name="name">Admin</field><field name="privilege_id" ref="privilege_hospital"/><field name="sequence">5</field><field name="implied_ids" eval="[Command.link(ref('group_hospital_manager'))]"/></record>
</odoo>
