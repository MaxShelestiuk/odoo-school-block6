<odoo noupdate="1">
    <record id="doctor_category_intern" model="hospital.doctor.category">
        <field name="name">Intern Doctor</field>
        <field name="sequence">10</field>
        <field name="is_intern" eval="True"/>
    </record>

    <record id="doctor_category_specialist" model="hospital.doctor.category">
        <field name="name">Specialist Doctor</field>
        <field name="sequence">20</field>
    </record>

    <record id="doctor_category_highest" model="hospital.doctor.category">
        <field name="name">Highest Category Doctor</field>
        <field name="sequence">30</field>
    </record>
</odoo>
